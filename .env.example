# Copy to `.env` for local development (never commit `.env`).

# --- Database (pick one style) ---

# Recommended for Neon + Render: full URI from Neon Console → Connect.
# Use the "direct" hostname (no "-pooler") if you want one URL for migrate, pg_dump, and the app.
# Pooled URI is also fine for Django on Neon (transaction pooler); use direct for pg_dump/migrations only.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.provider.neon.tech/neondb?sslmode=require&channel_binding=require

# Legacy split variables (e.g. local Postgres without a single URL):
# DB_NAME=postgres
# DB_USERNAME=
# DB_PASSWORD=
# DB_URL=127.0.0.1
# DB_HOST=5432

# --- One-off: copy local Postgres → Neon (not read by Django; for scripts/pg_local_to_neon.sh only)
# LOCAL_POSTGRES_URL=postgresql://USER:PASS@127.0.0.1:5432/your_local_dbname
# NEON_DIRECT_URL=postgresql://neondb_owner:PASS@ep-xxx.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Render / production (DEBUG=0) — set in Render dashboard, not committed ---
# SECRET_KEY=<strong-random>
# DEBUG=0
# ALLOWED_HOSTS=your-service.onrender.com
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-branch.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
# DATABASE_URL=postgresql://...@ep-xxx-pooler....neon.tech/neondb?sslmode=require&channel_binding=require
# SECURE_SSL_REDIRECT=0
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
# PYTHON_VERSION=3.13.5
